{
  "name": "dsh-codex-oauth",
  "version": "0.1.5",
  "description": "DeepSeek Harness plugin: use your OpenAI Codex (ChatGPT Plus/Pro) subscription through OAuth.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "codex",
    "openai",
    "oauth",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/birat-chapagain/dsh-codex-oauth.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-codex-oauth": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('lib/bin.js', 0o755)\"",
    "prepack": "npm run build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "npm run build && node node_modules/vitest/vitest.mjs run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@earendil-works/pi-ai": "^0.84.2",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.0-rc.7",
    "@deepseek-ai/cordis-plugin-include": "^1.0.4",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "vitest": "^4.1.8",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
